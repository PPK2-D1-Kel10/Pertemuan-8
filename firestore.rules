rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function assistant() { return signedIn() && profile().role == 'Asisten'; }
    function student() { return signedIn() && profile().role == 'Praktikan'; }
    function session(id) { return get(/databases/$(database)/documents/sessions/$(id)).data; }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function ownsRecord(data) {
      return signedIn() && (data.studentId == request.auth.uid || (assistant() && data.assistantId == request.auth.uid));
    }
    function newRecord(id, data) {
      let s = session(data.sessionId);
      return student()
        && id == data.sessionId + '_' + request.auth.uid
        && data.studentId == request.auth.uid
        && data.studentName == profile().name && data.studentNumber == profile().nim
        && data.assistantId == s.assistantId
        && request.auth.uid in s.participantIds && s.deleted == false
        && data.createdAt == request.time;
    }
    // Keep in sync with LAB in src/utils/attendanceValidation.ts (latitude, longitude, radiusMeters).
    function nearLab(location) {
      return location is latlng && location.distance(latlng.value(-7.0486, 110.4381)) <= 100;
    }
    function ownMissingRecord(id) {
      return signedIn() && id.matches('^[A-Za-z0-9]+_' + request.auth.uid + '$');
    }
    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || assistant());
      allow list: if false;
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'nim', 'role'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && text(request.resource.data.name, 2, 100)
        && request.resource.data.nim.matches('^[a-zA-Z0-9._-]{3,30}$')
        && request.resource.data.role == 'Praktikan';
      // Role changes are performed by a trusted project administrator through the Console/Admin SDK.
      allow update, delete: if false;
    }
    match /sessions/{id} {
      function validSession(data) {
        return data.keys().hasOnly(['practicalName', 'className', 'date', 'startTime', 'endTime', 'participantIds', 'assistantId', 'status', 'deleted', 'createdAt', 'updatedAt'])
          && text(data.practicalName, 1, 120) && text(data.className, 1, 60)
          && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && data.startTime < data.endTime
          && data.participantIds is list && data.participantIds.size() > 0 && data.participantIds.size() <= 100
          && data.participantIds.toSet().size() == data.participantIds.size()
          && data.deleted is bool && data.status in ['Belum Dibuka', 'Berlangsung', 'Selesai']
          && data.updatedAt == request.time;
      }
      allow get: if signedIn() && ((resource == null && assistant()) || (assistant() && resource.data.assistantId == request.auth.uid) || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && ((assistant() && resource.data.assistantId == request.auth.uid) || request.auth.uid in resource.data.participantIds);
      allow create: if assistant() && validSession(request.resource.data)
        && request.resource.data.assistantId == request.auth.uid
        && request.resource.data.status == 'Belum Dibuka' && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time;
      allow update: if assistant() && resource.data.assistantId == request.auth.uid
        && !resource.data.deleted && validSession(request.resource.data)
        && request.resource.data.assistantId == resource.data.assistantId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.status == 'Belum Dibuka' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['practicalName', 'className', 'date', 'startTime', 'endTime', 'participantIds', 'updatedAt']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && (
            (resource.data.status == 'Belum Dibuka' && request.resource.data.status == 'Berlangsung')
            || (resource.data.status == 'Berlangsung' && request.resource.data.status == 'Selesai')))
          || (resource.data.status != 'Berlangsung' && request.resource.data.deleted == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt']))
        );
      allow delete: if false;
    }
    match /attendance/{id} {
      allow get: if (resource == null && ownMissingRecord(id)) || ownsRecord(resource.data);
      allow list: if ownsRecord(resource.data);
      allow create: if request.resource.data.keys().hasOnly(['sessionId', 'assistantId', 'studentId', 'studentName', 'studentNumber', 'location', 'createdAt'])
        && newRecord(id, request.resource.data) && session(request.resource.data.sessionId).status == 'Berlangsung'
        && nearLab(request.resource.data.location);
      allow update, delete: if false;
    }
    match /permissions/{id} {
      allow get: if (resource == null && ownMissingRecord(id)) || ownsRecord(resource.data);
      allow list: if ownsRecord(resource.data);
      allow create: if request.resource.data.keys().hasOnly(['sessionId', 'assistantId', 'studentId', 'studentName', 'studentNumber', 'createdAt', 'reason', 'status', 'aiStatus', 'aiCategory', 'reviewedAt', 'reviewedBy'])
        && newRecord(id, request.resource.data)
        && text(request.resource.data.reason, 10, 2000)
        && request.resource.data.status == 'Menunggu Pemeriksaan'
        && request.resource.data.aiStatus == 'pending' && request.resource.data.aiCategory == null
        && request.resource.data.reviewedAt == null && request.resource.data.reviewedBy == null;
      allow update: if assistant() && resource.data.assistantId == request.auth.uid
        && resource.data.status == 'Menunggu Pemeriksaan'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['Diterima', 'Ditolak']
        && request.resource.data.reviewedAt == request.time && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
