# Copy to .env.local. These values come from Firebase Console > Project settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Never put an AI API key or Firebase service-account private key in EXPO_PUBLIC variables.

# Optional local-only demo (no Firebase account or billing needed).
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Optional trusted Gemini proxy; blank keeps the deployed baseline classifier.
EXPO_PUBLIC_AI_API_URL=
