# Salin file ini ke .env.backend.local (otomatis diabaikan Git)
# Dapatkan API Key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional: kosongkan untuk memilih otomatis model Flash/Flash-Lite Free Tier yang tersedia
GEMINI_MODEL=
AI_PROXY_HOST=127.0.0.1
AI_PROXY_PORT=3001
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Admin SDK credentials on backend only; never put these in EXPO_PUBLIC variables.
GOOGLE_APPLICATION_CREDENTIALS=
